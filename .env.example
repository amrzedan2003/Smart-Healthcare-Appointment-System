# Copy this file to .env and fill in the two secrets before running Docker Compose.

# Application Configuration
SERVER_PORT=8080

# Database Configuration
POSTGRES_PORT=5432
POSTGRES_DB=healthcare_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# MongoDB Configuration
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=healthcare_db

# JWT Configuration
# HS256 needs at least 32 characters; generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=86400000
